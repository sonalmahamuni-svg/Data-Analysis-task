    "#task 2.a\n",
    "# if-else\n",
    "# 1) grade code \n",
    "p = 50\n",
    "if p > 75:\n",
    "    print(\"O\")\n",
    "elif p > 60:\n",
    "    print(\"A\")\n",
    "elif p >= 50:  \n",
    "    print(\"B\")\n",
    "elif p > 35:\n",
    "    print(\"C\")\n",
    "else:\n",
    "    print(\"fail\")\n",
    " \n",
    "# 2) n divisible by 2 or 3\n",
    "n = 7\n",
    "if n % 2 == 0 and n % 3 == 0:\n",
    "    print(\"divisible by 2, and 3\")\n",
    "elif n % 2 == 0 and n % 3 != 0:\n",
    "    print(\"2 divisible, 3 not\")\n",
    "elif n % 3 == 0 and n % 2 != 0:\n",
    "    print(\"divisible by 3, not 2\")\n",
    "else:\n",
    "    print(\"not divisible by 2, and 3\")\n",
    "\n",
    "# 3)\n",
    "light = \"yellow\"\n",
    "if light == \"red\":\n",
    "    print(\"Stop\")\n",
    "elif light == \"yellow\":\n",
    "    print(\"Slow down\")\n",
    "elif light == \"green\":\n",
    "    print(\"Go\")\n",
    "else:\n",
    "    print(\"Invalid color\")\n",
    "\n",
    "# 4)\n",
    "age = 15\n",
    "\n",
    "if age < 13:\n",
    "    print(\"Child\")\n",
    "elif age < 20:\n",
    "    print(\"Teenager\")\n",
    "else:\n",
    "    print(\"Adult\")\n",
    "\n",
    "# 5)\n",
    "num = -5\n",
    "if num > 0:\n",
    "    print(\"Positive number\")\n",
    "elif num < 0:\n",
    "    print(\"Negative number\")\n",
    "else:\n",
    "    print(\"Zero\")\n",
    "\n",
    "# 6)\n",
    "age = 65\n",
    "if age < 5:\n",
    "    print(\"Free ticket\")\n",
    "elif age >= 60:\n",
    "    print(\"Senior discount: $5\")\n",
    "else:\n",
    "    print(\"Standard ticket: $10\")\n",
    "\n",
    "# 7)    \n",
    "temp = 18  \n",
    "if temp > 30:\n",
    "    print(\"Stay indoors, it is hot\")\n",
    "elif temp >= 15:\n",
