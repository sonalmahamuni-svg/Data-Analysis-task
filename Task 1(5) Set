   "source": [
    "# 5 SETS\n",
    "\n",
    "# 1. Create two sets\n",
    "set_a = {1, 2, 3, 4}\n",
    "set_b = {3, 4, 5, 6}\n",
    "\n",
    "# 2. Add an element\n",
    "set_a.add(10)\n",
    "print(\"Add:\", set_a)\n",
    "\n",
    "# 3. Remove an element\n",
    "set_a.remove(2)\n",
    "print(\"Remove:\", set_a)\n",
    "\n",
    "# 4. Union \n",
    "print(\"Union:\", set_a.union(set_b))\n",
    "\n",
    "# 5. Intersection \n",
    "print(\"Intersection:\", set_a.intersection(set_b))\n",
    "\n",
    "# 6. Difference \n",
    "print(\"Difference:\", set_a.difference(set_b))"
   ]
