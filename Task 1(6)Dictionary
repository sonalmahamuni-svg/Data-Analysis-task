    "# 6 DICTIONARIES \n",
    "\n",
    "user = {\"name\": \"Sonal\", \"role\": \"Intern\", \"year\": 2026}\n",
    "\n",
    "# Accessing & Adding\n",
    "print(user[\"name\"])\n",
    "print(user.get(\"status\", \"Active\"))\n",
    "user[\"location\"] = \"Pune\"\n",
    "\n",
    "# View items\n",
    "print(user.keys())\n",
    "print(user.values())\n",
    "print(user.items())\n",
    "\n",
    "# Removing & Updating\n",
    "user.pop(\"year\")\n",
    "user.update({\"role\": \"Engineer\"})\n",
    "print(user)"
