    "# 7 ERRORS \n",
    "\n",
    "# 1. IndentationError (Fix: Align spaces)\n",
    "def greet():\n",
    "    print(\"Hello\")\n",
    "\n",
    "\n",
    "# 2. NameError (Fix: Define variable before use)\n",
    "score = 100\n",
    "print(score)\n",
    "\n",
    "\n",
    "# 3. ValueError (Fix: Check string value before int conversion)\n",
    "text = \"20\"\n",
    "if text.isdigit():\n",
    "    print(int(text))\n",
    "\n",
    "\n",
    "# 4. TypeError (Fix: Convert numbers to strings before adding to text)\n",
    "print(\"Age: \" + str(25))\n",
    "\n",
    "\n",
    "# 5. IndexError (Fix: Do not access items past the list size)\n",
    "items = [10, 20]\n",
    "if len(items) > 1:\n",
    "    print(items[1])\n",
    "\n",
    "\n",
    "# 6. KeyError (Fix: Check if key exists or use get())\n",
    "user={\"name\":\"Sonal\"}\n",
    "print(user.get(\"email\", \"Not found\"))"
